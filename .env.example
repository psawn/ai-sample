GEMINI_API_KEY=
OPENAI_API_KEY=
HUGGINGFACE_ACCESS_TOKEN=
ANTHROPIC_API_KEY=
CHROMA_HOST=localhost
CHROMA_PORT=8000
TYPESAFE_API_KEY=
TAVILY_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=
MONGODB_COLLECTION=
INDEX_NAME=vector_index
# Dạng: postgresql://<username>:<password>@<host>:<port>/<database>
POSTGRES_URI=postgresql://postgres:postgres@localhost:5432/postgres
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT="AI Sample"
# AWS Bedrock Guardrails: access key của IAM user có quyền Bedrock
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

GROQ_API_KEY=

# Bifrost: mật khẩu tự đặt, dùng 1 lần để tạo tài khoản admin. VD tạo bằng PowerShell: [guid]::NewGuid()
BIFROST_SETUP_TOKEN=
# Bifrost: 2 virtual key khai báo trong bifrost-config.json, tự đặt dạng sk-bf-<chuỗi ngẫu nhiên>.
# Có thể tạo bằng UI, nhưng phải dùng giá trị khác 2 key này.
# Virtual key cho Phần 1–12, 14
BIFROST_VIRTUAL_KEY=
# Virtual key cho Phần 13 (budget)
BIFROST_BUDGET_VK=
# Bifrost: ID prompt cho Phần 14. Tạo ở trang Prompt Repository của UI
BIFROST_PROMPT_ID=
